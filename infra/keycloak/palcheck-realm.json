      "username": "hr.admin@acme.example",
      "email": "hr.admin@acme.example",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Rebeca",
      "lastName": "Umaña Salas",
      "credentials": [{ "type": "password", "value": "${PALCHECK_DEMO_USER_PASSWORD}", "temporary": false }]
    },
    {
