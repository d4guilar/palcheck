# Copy to `.env` (untracked) before `docker compose up -d` and before running the backend.
# These are DEVELOPMENT-ONLY placeholder values for a local, throwaway environment. They are not real secrets.
# Never reuse them anywhere else, and never commit a real `.env`.

# PostgreSQL (docker-compose service and backend datasource)
PALCHECK_DB_NAME=palcheck
PALCHECK_DB_USER=palcheck
PALCHECK_DB_PASSWORD=change-me-local-dev
PALCHECK_DB_PORT=5432
PALCHECK_DB_URL=jdbc:postgresql://localhost:5432/palcheck

# Keycloak (development identity provider)
KEYCLOAK_PORT=8180
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-local-dev

# Backend OIDC client (must match infra/keycloak/palcheck-realm.json placeholders)
PALCHECK_OIDC_ISSUER_URI=http://localhost:8180/realms/palcheck
PALCHECK_OIDC_CLIENT_SECRET=change-me-local-dev-client-secret

# Password for the synthetic demo users (hr.admin@acme.example, hr.viewer@acme.example, ...)
PALCHECK_DEMO_USER_PASSWORD=change-me-local-dev-user
